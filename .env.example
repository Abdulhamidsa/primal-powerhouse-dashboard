# Database Configuration
# IMPORTANT: Add connection pooling parameters to prevent "too many connections" errors

# PostgreSQL/Supabase with connection pooling
DATABASE_URL="postgresql://user:password@host:5432/dbname?connection_limit=5&pool_timeout=10"

# Direct URL for migrations (without pooling)
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# For Supabase specifically, add pgbouncer parameter
# DATABASE_URL="postgresql://user:password@host.supabase.co:5432/postgres?connection_limit=5&pool_timeout=10&pgbouncer=true"

# Connection Pool Parameters:
# - connection_limit: Max connections per Prisma Client instance (recommended: 5-10)
# - pool_timeout: Seconds to wait for connection (recommended: 10-20)
# - pgbouncer: Enable PgBouncer connection pooling (Supabase)

# Cloudinary (for meal images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Realtime Chat (Pusher)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# Chat Security
# Recommended: keep this true so chat media is uploaded as authenticated/private assets.
CHAT_MEDIA_PRIVATE_DELIVERY=true

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# RapidAPI ExerciseDB V2
# Get from: https://rapidapi.com/ascendapi/api/edb-with-videos-and-images-by-ascendapi
RAPIDAPI_KEY=your_rapidapi_key
NEXT_PUBLIC_RAPIDAPI_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com

# Node Environment
NODE_ENV=development

# Production operations (production must use these exact retention values)
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_MASTER_KEY_BASE64=
FIELD_ENCRYPTION_KEY_VERSION=v1
PRIVACY_DELETION_GRACE_DAYS=30
PRIVACY_EXPORT_EXPIRY_HOURS=24
PRIVACY_AUDIT_RETENTION_DAYS=365

# Curated self-service starter plan sources (required for SELF_SERVICE clients)
SELF_SERVICE_STARTER_CLIENT_ID=
SELF_SERVICE_STARTER_MEAL_PLAN_ID=
SELF_SERVICE_STARTER_TRAINING_PLAN_ID=

# Optional Phase 3 age declaration enforcement (unset keeps current signup behavior)
# PRIMAL_MINIMUM_AGE=
# PRIMAL_AGE_DECLARATION_VERSION=age-declaration-v1

# Optional versioned policy acknowledgements (unset means no policy reacceptance is required)
# Approval is also required in the legal registry; these variables cannot promote drafts.
# PRIMAL_LEGAL_ACCEPTANCE_ENABLED=false
# PRIMAL_TERMS_VERSION=
# PRIMAL_PRIVACY_POLICY_VERSION=
# PRIMAL_AI_DISCLOSURE_VERSION=
