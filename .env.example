# Development Environment Variables
DATABASE_URL="file:./dev.db"

# Production Environment Variables (override in deployment)
# DATABASE_URL="postgresql://username:password@host:port/database"
# DATABASE_URL="mysql://username:password@host:port/database"

# Application Settings
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"

# Optional: JWT Secret for custom auth
JWT_SECRET="your-jwt-secret-change-in-production"

# Optional: Email configuration for notifications
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# ===========================
# Cloudinary Configuration
# ===========================
# Required for image uploads and management
# Get these from: https://cloudinary.com/console

# Your Cloudinary cloud name (required - public)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# Upload preset for unsigned uploads (required - public)
# Create an unsigned upload preset in Cloudinary settings
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# Optional: Default folder for uploads (public)
NEXT_PUBLIC_CLOUDINARY_FOLDER="meals"

# API credentials for server-side operations (required for deletion)
# Keep these SECRET - never expose in client-side code
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
