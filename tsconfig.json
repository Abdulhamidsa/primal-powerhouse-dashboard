{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@primal/theme": ["./packages/theme/src/index.ts"],
      "@primal/theme/web.css": ["./packages/theme/generated/themes.css"]
    }
    // "types": [
    //   "node",
    //   "react",
    //   "react-dom",
    //   "jsonwebtoken"
    // ]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "src/react-augment.d.ts.bak", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next/**/*", "apps/**/*", "packages/**/*"]
}
