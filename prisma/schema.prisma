model WorkoutPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  coachId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach       User                    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  exercises   WorkoutPlanExercise[]
  assignments WorkoutPlanAssignment[]

  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id                String  @id @default(cuid())
  workoutPlanId     String
  videoId           String
  order             Int
  targetSets        Int     @default(3)
  minReps           Int     @default(8)
  maxReps           Int     @default(12)
  suggestedWeightKg Float?
  restSeconds       Int     @default(120)
  notes             String?

  workoutPlan  WorkoutPlan   @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  video        Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]

  @@map("workout_plan_exercises")
}

model WorkoutPlanAssignment {
  id            String   @id @default(cuid())
  workoutPlanId String
  clientId      String
  assignedAt    DateTime @default(now())
  isActive      Boolean  @default(true)

  workoutPlan WorkoutPlan      @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]

  @@map("workout_plan_assignments")
}

model WorkoutSession {
  id               String               @id @default(cuid())
  clientId         String
  planAssignmentId String
  status           WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt        DateTime             @default(now())
  completedAt      DateTime?

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planAssignment WorkoutPlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)
  exerciseLogs   ExerciseLog[]

  @@map("workout_sessions")
}

model ExerciseLog {
  id             String                @id @default(cuid())
  sessionId      String
  planExerciseId String
  completedAt    DateTime?
  feedback       ExerciseFeedbackType?
  feedbackNote   String?

  session      WorkoutSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  planExercise WorkoutPlanExercise @relation(fields: [planExerciseId], references: [id], onDelete: Cascade)
  sets         SetLog[]

  @@map("exercise_logs")
}

model SetLog {
  id            String   @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  reps          Int
  weightKg      Float
  completed     Boolean  @default(true)
  loggedAt      DateTime @default(now())

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@map("set_logs")
}

/**
 * =========================
 * NEW TRAINING SYSTEM MODELS
 * =========================
 */

model Exercise {
  id                   String       @id @default(cuid())
  name                 String
  description          String?
  muscleGroup          MuscleGroup
  muscleGroupSecondary MuscleGroup?
  equipment            Equipment?
  videoUrl             String?
  imageUrl             String?
  instructions         String?

  defaultSets        Int?
  defaultReps        Int?
  defaultRestSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coachId String
  coach   User   @relation("ExerciseCoach", fields: [coachId], references: [id], onDelete: Cascade)

  templates               WorkoutTemplateExercise[]
  TrainingSessionExercise TrainingSessionExercise[]

  @@index([coachId])
  @@index([muscleGroup])
  @@map("exercises")
}

model WorkoutTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?
  goal        String?
  difficulty  DifficultyLevel?

  sourceType       SourceType @default(MANUAL)
  aiGenerated      Boolean    @default(false)
  aiPromptSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coachId String
  coach   User   @relation("WorkoutTemplateCoach", fields: [coachId], references: [id], onDelete: Cascade)

  exercises WorkoutTemplateExercise[]
  planDays  TrainingPlanDay[]
  sessions  TrainingSession[]

  @@index([coachId])
  @@index([difficulty])
  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id          String @id @default(cuid())
  order       Int
  sets        Int    @default(3)
  reps        Int    @default(8)
  restSeconds Int    @default(120)

  targetRpe   Float?
  targetTempo String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutTemplateId String
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutTemplateId, order])
  @@index([workoutTemplateId])
  @@index([exerciseId])
  @@map("workout_template_exercises")
}

model ClientTrainingPlan {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  sourceType       SourceType @default(MANUAL)
  aiGenerated      Boolean    @default(false)
  aiPromptSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client @relation("TrainingPlans", fields: [clientId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("TrainingPlansCoach", fields: [coachId], references: [id], onDelete: Cascade)

  days TrainingPlanDay[]

  @@index([clientId])
  @@index([coachId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("client_training_plans")
}

model TrainingPlanDay {
  id   String          @id @default(cuid())
  date DateTime
  type TrainingDayType @default(WORKOUT)

  workoutTemplateId String?
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)

  title String?
  note  String?

  status PlanDayStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planId String
  plan   ClientTrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sessions TrainingSession[]

  @@unique([planId, date])
  @@index([planId, date])
  @@index([date])
  @@index([status])
  @@map("training_plan_days")
}

model TrainingSession {
  id     String                @id @default(cuid())
  status TrainingSessionStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  planDayId String
  planDay   TrainingPlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation("TrainingSessions", fields: [clientId], references: [id], onDelete: Cascade)

  workoutTemplateId String?
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)

  perceivedDifficulty PerceivedDifficulty?
  overallFeedback     String?
  caloriesBurned      Float?

  sourceType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coachId String
  coach   User   @relation("TrainingSessionsCoach", fields: [coachId], references: [id], onDelete: Cascade)

  exercises TrainingSessionExercise[]

  @@index([clientId])
  @@index([coachId])
  @@index([planDayId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
  @@map("training_sessions")
}

model TrainingSessionExercise {
  id    String @id @default(cuid())
  order Int

  exerciseNameSnapshot String
  muscleGroupSnapshot  MuscleGroup?
  equipmentSnapshot    String?
  notesSnapshot        String?

  plannedSets         Int
  plannedReps         Int
  plannedRestSeconds  Int
  targetRpeSnapshot   Float?
  targetTempoSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  sets TrainingSessionSet[]

  @@unique([sessionId, order])
  @@index([sessionId])
  @@index([exerciseId])
  @@map("training_session_exercises")
}

model TrainingSessionSet {
  id        String @id @default(cuid())
  setNumber Int

  plannedReps        Int
  plannedWeightKg    Float?
  plannedRestSeconds Int

  actualReps     Int?
  actualWeightKg Float?

  completed Boolean @default(false)
  skipped   Boolean @default(false)
  feedback  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionExerciseId String
  sessionExercise   TrainingSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  RestTimer         RestTimer?

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId])
  @@map("training_session_sets")
}

model RestTimer {
  id String @id @default(cuid())

  sessionSetId String             @unique
  sessionSet   TrainingSessionSet @relation(fields: [sessionSetId], references: [id], onDelete: Cascade)

  plannedSeconds Int
  actualSeconds  Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@map("rest_timers")
}

model MobileSession {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  refreshHash String @unique
  authenticatedAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  devices MobilePushDevice[]
  @@index([clientId])
}

model MobilePushDevice {
  id String @id @default(cuid())
  sessionId String
  session MobileSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token String @unique
  updatedAt DateTime @updatedAt
}

model MobilePushDelivery {
  id String @id @default(cuid())
  messageId String
  deviceToken String
  receiptId String?
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([messageId, deviceToken])
  @@index([status, createdAt])
}
