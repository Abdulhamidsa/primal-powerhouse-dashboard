// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(COACH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  meals    Meal[]
  clients  Client[]
  workouts Workout[]
  videos   Video[]

  @@map("users")
}

model Client {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  password             String?  // Optional for backward compatibility
  phone                String?
  avatar               String?
  status               ClientStatus @default(ACTIVE)
  joinDate             DateTime @default(now())
  currentWeight        Float?
  targetWeight         Float?
  height               Float?
  age                  Int?
  activityLevel        ActivityLevel?
  dietaryRestrictions  String? // JSON string
  goals                String? // JSON string
  notes                String?
  motivationalMessage  String? // Custom motivational message for client dashboard
  lastSession          DateTime?
  nextSession          DateTime?
  sessionsCompleted    Int      @default(0)
  progressPhotos       String? // JSON string
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  coachId  String
  coach    User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workouts Workout[]
  mealPlans MealPlan[]
  videoAssignments VideoAssignment[]
  meals    Meal[] // Relation to personalized meals for this client

  @@map("clients")
}

model Meal {
  id           String   @id @default(cuid())
  name         String
  type         MealType
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float?
  ingredients  String? // JSON string
  instructions String? // JSON string
  prepTime     Int?     // minutes
  cookTime     Int?     // minutes
  servings     Int      @default(1)
  tags         String? // JSON string
  imageUrl     String?
  isPersonalized Boolean @default(false)
  originalMealId String? // Reference to the original meal if this is a personalized copy
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  // Add relation to Client for personalized meals
  clientId String? // Optional client ID for personalized meals
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mealAssignments MealAssignment[]

  @@map("meals")
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    VideoCategory
  difficulty  DifficultyLevel
  duration    Int      // duration in seconds
  videoUrl    String   // URL to video file or YouTube/Vimeo URL
  thumbnailUrl String?
  equipment   String? // JSON string for required equipment
  muscleGroups String? // JSON string for target muscle groups
  tags        String? // JSON string for tags
  instructions String? // JSON string for exercise instructions
  tips        String? // JSON string for tips and form cues
  isPublic    Boolean @default(true)
  viewCount   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  videoAssignments VideoAssignment[]

  @@map("videos")
}

model Workout {
  id             String   @id @default(cuid())
  date           DateTime
  type           WorkoutType
  duration       Int      // minutes
  exercises      String   // JSON string containing exercise data
  notes          String?
  caloriesBurned Float?
  rating         Int?     // 1-5 rating
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId  String
  coach    User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

    @@map("workouts")
}

model MealPlan {
  id         String    @id @default(cuid())
  name       String    // e.g., "Week 1 Plan", "Weight Loss Plan"
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  mealAssignments MealAssignment[]

  @@map("meal_plans")
}

model MealAssignment {
  id           String   @id @default(cuid())
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday, etc.
  mealType     MealType
  portion      Float    @default(1.0) // serving size multiplier
  scheduledTime String?  // Time in HH:MM format
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_assignments")
}

model VideoAssignment {
  id            String   @id @default(cuid())
  assignedDate  DateTime @default(now())
  dueDate       DateTime?
  scheduledTime String?  // Time in HH:MM format
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  notes         String?
  progress      Float    @default(0.0) // 0.0 to 100.0 percentage
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_assignments")
}

// Enums

model Session {
  id        String   @id @default(cuid())
  clientId  String
  coachId   String
  date      DateTime
  type      WorkoutType
  duration  Int      // minutes
  status    SessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Enums
enum Role {
  COACH
  ADMIN
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum ActivityLevel {
  LOW
  MODERATE
  HIGH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutType {
  STRENGTH_TRAINING
  CARDIO
  FUNCTIONAL
  FLEXIBILITY
  SPORTS_SPECIFIC
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VideoCategory {
  STRENGTH_TRAINING
  CARDIO
  MOBILITY
  FUNCTIONAL
  YOGA
  PILATES
  WARM_UP
  COOL_DOWN
  REHABILITATION
  SPORTS_SPECIFIC
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}
