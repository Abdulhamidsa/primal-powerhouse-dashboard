// Prisma schema for Primal Powerhouse
// PostgreSQL + Hetzner ready

generator client {
  provider = "prisma-client-js"
  // Keep both to be safe across local/dev/prod
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL") // Direct connection for migrations, bypassing connection pooling
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/* =========================
   MODELS
========================= */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(COACH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals     Meal[]
  clients   Client[]
  workouts  Workout[]
  videos    Video[]
  sessions  Session[]
  foodsCreated Food[]

  @@map("users")
}

model Client {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String?
  phone               String?
  avatar              String?
  status              ClientStatus @default(ACTIVE)
  joinDate            DateTime @default(now())
  currentWeight       Float?
  targetWeight        Float?
  height              Float?
  age                 Int?
  gender              Gender?
  activityLevel       ActivityLevel?
  dietaryRestrictions String?
  goals               String?
  notes               String?
  motivationalMessage String?
  phoneEncrypted               String?
  dietaryRestrictionsEncrypted String?
  goalsEncrypted               String?
  notesEncrypted               String?
  motivationalMessageEncrypted String?
  lastSession         DateTime?
  nextSession         DateTime?
  sessionsCompleted   Int      @default(0)
  progressPhotos      String?
  goalCalories        Int?
  goalMacros          String? // JSON: {protein, carbs, fat}
  consentAnalytics              Boolean   @default(false)
  consentMarketingNotifications Boolean   @default(false)
  consentOptionalTracking       Boolean   @default(false)
  privacyUpdatedAt              DateTime?
  deactivatedAt                 DateTime?
  anonymizedAt                  DateTime?
  deletionScheduledFor          DateTime?
  deletedAt                     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coachId  String
  coach    User     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  workouts          Workout[]
  mealPlans         MealPlan[]
  videoAssignments  VideoAssignment[]
  meals             Meal[]
  feedback          Feedback[]
  sessions          Session[]
  healthMetrics     HealthMetric[]
  weeklyCheckIns    WeeklyCheckIn[]
  dailyNutritionLogs DailyNutritionLog[]
  dailyTrainingLogs DailyTrainingLog[]
  privacyExportJobs PrivacyExportJob[]
  deletionRequests  DeletionRequest[]

  @@map("clients")
}

model HealthMetric {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  weight          Float
  bmi             Float
  bmr             Int
  tdee            Int
  recommendedCals Int
  bmiCategory     String
  goal            String?
  
  macros          String // JSON: {protein, carbs, fat}
  notes           String? // feedback/warnings
  notesEncrypted  String?
  
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@index([clientId])
  @@index([recordedAt])
  @@map("health_metrics")
}

model Meal {
  id              String   @id @default(cuid())
  name            String
  type            MealType
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float?
  ingredients     String?
  instructions    String?
  prepTime        Int?
  cookTime        Int?
  servings        Int      @default(1)
  tags            String?
  imageUrl        String?
  isPersonalized  Boolean  @default(false)
  originalMealId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  mealAssignments MealAssignment[]

  @@map("meals")
}

model Food {
  id               String       @id @default(cuid())
  name             String
  category         String
  state            FoodState
  caloriesKcal     Float
  proteinG         Float
  carbsG           Float
  fatG             Float
  fiberG           Float?
  source           FoodSource   @default(SYSTEM)
  isActive         Boolean      @default(true)
  sourceRef        String?
  verifiedAt       DateTime?
  verifiedBy       String?
  baseUnit         FoodBaseUnit @default(HUNDRED_G)
  gramsPerUnit     Float?
  displayUnitLabel String?
  createdById      String?
  createdBy        User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@map("foods")
}

model Video {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      VideoCategory
  difficulty    DifficultyLevel
  duration      Int
  videoUrl      String
  thumbnailUrl  String?
  equipment     String?
  muscleGroups  String?
  tags          String?
  instructions  String?
  tips          String?
  isPublic      Boolean  @default(true)
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  videoAssignments VideoAssignment[]

  @@map("videos")
}

model Workout {
  id             String   @id @default(cuid())
  date           DateTime
  type           WorkoutType
  duration       Int
  exercises      String
  notes          String?
  caloriesBurned Float?
  rating         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model MealPlan {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  mealAssignments MealAssignment[]

  @@map("meal_plans")
}


model MealAssignment {
  id            String   @id @default(cuid())
  dayOfWeek     Int
  mealType      MealType
  portion       Float    @default(1.0)
  scheduledTime String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_assignments")
}

model VideoAssignment {
  id            String   @id @default(cuid())
  assignedDate  DateTime @default(now())
  dueDate       DateTime?
  scheduledTime String?
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  notes         String?
  progress      Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_assignments")
}

model Session {
  id        String   @id @default(cuid())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  coachId   String
  coach     User    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  date      DateTime
  type      WorkoutType
  duration  Int
  status    SessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  messageEncrypted String?
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("feedback")
}

model WeeklyCheckIn {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  weekStartDate       DateTime
  submittedAt         DateTime @default(now())

  weightKg            Float?
  waistCm             Float?
  trainingAdherence   Int
  nutritionAdherence  Int
  energyRating        Int
  stressRating        Int?
  hungerRating        Int?
  digestionRating     Int?
  sleepHours          Float?
  strengthUpdate      String?
  blockerText         String?
  notes               String?
  strengthUpdateEncrypted String?
  blockerTextEncrypted    String?
  notesEncrypted          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([clientId, weekStartDate])
  @@index([clientId])
  @@index([weekStartDate])
  @@map("weekly_check_ins")
}

model DailyNutritionLog {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayDate    DateTime
  status     DailyNutritionStatus
  note       String?
  submittedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, dayDate])
  @@index([clientId])
  @@index([dayDate])
  @@map("daily_nutrition_logs")
}

model DailyTrainingLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayDate     DateTime
  status      DailyTrainingStatus
  note        String?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, dayDate])
  @@index([clientId])
  @@index([dayDate])
  @@map("daily_training_logs")
}

model PrivacyExportJob {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status            PrivacyExportStatus @default(PENDING)
  format            PrivacyExportFormat @default(JSON_AND_CSV)
  requestedAt       DateTime @default(now())
  completedAt       DateTime?
  expiresAt         DateTime
  downloadTokenHash String?
  downloadCount     Int      @default(0)
  downloadedAt      DateTime?
  payloadJson       String?
  csvBundleJson     String?
  storageKey        String?
  error             String?

  @@index([clientId])
  @@index([expiresAt])
  @@map("privacy_export_jobs")
}

model DeletionRequest {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status               DeletionRequestStatus @default(REQUESTED)
  requestedAt          DateTime @default(now())
  gracePeriodDays      Int      @default(30)
  scheduledHardDeleteAt DateTime
  anonymizedAt         DateTime?
  finalizedAt          DateTime?
  cancelledAt          DateTime?
  reason               String?
  metadata             String?

  @@index([clientId])
  @@index([scheduledHardDeleteAt])
  @@map("deletion_requests")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorRole    String?
  targetUserId String?
  action       String
  ipHash       String?
  userAgent    String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IngredientMacroRefreshJob {
  id                   String @id @default(cuid())
  foodId               String
  requestedById        String
  status               IngredientMacroRefreshStatus @default(PENDING)
  scope                IngredientMacroRefreshScope @default(ALL)
  affectedMealsCount   Int @default(0)
  processedMealsCount  Int @default(0)
  failedMealsCount     Int @default(0)
  nextOffset           Int @default(0)
  failedMealErrorsJson String?
  error                String?
  requestedAt          DateTime @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  updatedAt            DateTime @updatedAt

  @@index([foodId])
  @@index([status])
  @@index([requestedAt])
  @@map("ingredient_macro_refresh_jobs")
}

model MealPlanRecalculationAudit {
  id                      String   @id
  mealPlanId              String
  clientId                String
  actorId                 String
  reason                  String?
  mode                    String
  oldTargets              String
  newTargets              String
  projectedTotals         String
  expectedAccuracyPercent Float
  hasBoundsClamping       Boolean  @default(false)
  deltas                  String
  createdAt               DateTime @default(now())

  @@index([mealPlanId])
  @@index([clientId])
  @@index([actorId])
  @@index([createdAt])
  @@map("meal_plan_recalculation_audits")
}

/* =========================
   ENUMS
========================= */

enum Gender {
  MALE
  FEMALE
}

enum Role {
  COACH
  ADMIN
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum ActivityLevel {
  LOW
  MODERATE
  HIGH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutType {
  STRENGTH_TRAINING
  CARDIO
  FUNCTIONAL
  FLEXIBILITY
  SPORTS_SPECIFIC
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VideoCategory {
  STRENGTH_TRAINING
  CARDIO
  MOBILITY
  FUNCTIONAL
  YOGA
  PILATES
  WARM_UP
  COOL_DOWN
  REHABILITATION
  SPORTS_SPECIFIC
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum PrivacyExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

enum PrivacyExportFormat {
  JSON
  JSON_AND_CSV
}

enum DeletionRequestStatus {
  REQUESTED
  ANONYMIZED
  FINALIZED
  CANCELLED
}

enum DailyNutritionStatus {
  ON_PLAN
  PARTIAL
  OFF_PLAN
}

enum DailyTrainingStatus {
  DONE
  PARTIAL
  MISSED
}

enum FoodState {
  RAW
  DRY
  AS_SOLD
  COOKED
}

enum FoodSource {
  SYSTEM
  CUSTOM
}

enum FoodBaseUnit {
  HUNDRED_G
  UNIT
}

enum IngredientMacroRefreshStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum IngredientMacroRefreshScope {
  ALL
  TEMPLATES_ONLY
}
