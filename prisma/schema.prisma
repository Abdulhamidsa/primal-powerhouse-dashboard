// Prisma schema for Primal Powerhouse
// PostgreSQL + Hetzner ready

generator client {
  provider = "prisma-client-js"
  // Keep both to be safe across local/dev/prod
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL") // Direct connection for migrations, bypassing connection pooling
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/* =========================
   MODELS
========================= */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(COACH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals     Meal[]
  clients   Client[]
  workouts  Workout[]
  videos    Video[]
  sessions  Session[]

  @@map("users")
}

model Client {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String?
  phone               String?
  avatar              String?
  status              ClientStatus @default(ACTIVE)
  joinDate            DateTime @default(now())
  currentWeight       Float?
  targetWeight        Float?
  height              Float?
  age                 Int?
  activityLevel       ActivityLevel?
  dietaryRestrictions String?
  goals               String?
  notes               String?
  motivationalMessage String?
  lastSession         DateTime?
  nextSession         DateTime?
  sessionsCompleted   Int      @default(0)
  progressPhotos      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coachId  String
  coach    User     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  workouts          Workout[]
  mealPlans         MealPlan[]
  videoAssignments  VideoAssignment[]
  meals             Meal[]
  feedback          Feedback[]
  sessions          Session[]

  @@map("clients")
}

model Meal {
  id              String   @id @default(cuid())
  name            String
  type            MealType
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float?
  ingredients     String?
  instructions    String?
  prepTime        Int?
  cookTime        Int?
  servings        Int      @default(1)
  tags            String?
  imageUrl        String?
  isPersonalized  Boolean  @default(false)
  originalMealId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  mealAssignments MealAssignment[]

  @@map("meals")
}

model Video {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      VideoCategory
  difficulty    DifficultyLevel
  duration      Int
  videoUrl      String
  thumbnailUrl  String?
  equipment     String?
  muscleGroups  String?
  tags          String?
  instructions  String?
  tips          String?
  isPublic      Boolean  @default(true)
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  videoAssignments VideoAssignment[]

  @@map("videos")
}

model Workout {
  id             String   @id @default(cuid())
  date           DateTime
  type           WorkoutType
  duration       Int
  exercises      String
  notes          String?
  caloriesBurned Float?
  rating         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model MealPlan {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  mealAssignments MealAssignment[]

  @@map("meal_plans")
}


model MealAssignment {
  id            String   @id @default(cuid())
  dayOfWeek     Int
  mealType      MealType
  portion       Float    @default(1.0)
  scheduledTime String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_assignments")
}

model VideoAssignment {
  id            String   @id @default(cuid())
  assignedDate  DateTime @default(now())
  dueDate       DateTime?
  scheduledTime String?
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  notes         String?
  progress      Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_assignments")
}

model Session {
  id        String   @id @default(cuid())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  coachId   String
  coach     User    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  date      DateTime
  type      WorkoutType
  duration  Int
  status    SessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("feedback")
}

/* =========================
   ENUMS
========================= */

enum Role {
  COACH
  ADMIN
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum ActivityLevel {
  LOW
  MODERATE
  HIGH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutType {
  STRENGTH_TRAINING
  CARDIO
  FUNCTIONAL
  FLEXIBILITY
  SPORTS_SPECIFIC
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VideoCategory {
  STRENGTH_TRAINING
  CARDIO
  MOBILITY
  FUNCTIONAL
  YOGA
  PILATES
  WARM_UP
  COOL_DOWN
  REHABILITATION
  SPORTS_SPECIFIC
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}
