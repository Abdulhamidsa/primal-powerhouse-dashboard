# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
pnpm-lock.yaml

# Testing
/coverage
*.test.js
*.test.ts
*.spec.js
*.spec.ts
test-*.js
test-*.ts
/__tests__/

# Next.js
/.next/
/out/
.next

# Production builds
/build
/dist
*.tgz

# Environment files
.env*
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3
/prisma/dev.db*
prisma/migrations/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/

# Credentials and sensitive files
LOGIN_CREDENTIALS.txt
QUICK_LOGIN.txt
*credentials*
*password*
*secret*
*private*

# Development scripts
check-*.js
test-*.js
fix-*.js
seed-*.js
create-*.js
list-*.js
cleanup-*.js
add-*.js
get-*.js
set-*.js

# Documentation that's not needed in production
*.md
!README.md
DEPLOYMENT.md
VIDEO_SYSTEM_READY.md

# Certificates
*.pem
*.key
*.crt
*.p12

# Backup files
*.backup
*.bak
*.old

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
/src/generated/prisma

# Miscellaneous
.nyc_output
coverage/
*.lcov
.eslintcache
.stylelintcache
