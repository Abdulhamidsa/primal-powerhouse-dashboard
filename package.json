{
  "name": "primal-powerhouse-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate:safe": "node scripts/prisma-generate-safe.js",
    "predev": "pnpm prisma:generate:safe",
    "dev": "dotenv -e .env.dev -- next dev --turbo",
    "predev:prod": "pnpm prisma:generate:safe",
    "dev:prod": "dotenv -e .env.prod -- next dev --turbo",
    "predb:migrate:dev": "pnpm prisma:generate:safe",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "predb:migrate:prod": "pnpm prisma:generate:safe",
    "db:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "db:studio:prod": "dotenv -e .env.prod -- prisma studio",
    "db:foods:import:dev": "dotenv -e .env.dev -- node scripts/import-food-patch.js",
    "db:foods:import:prod": "dotenv -e .env.prod -- node scripts/import-food-patch.js",
    "privacy:cleanup": "node scripts/privacy-cleanup.js",
    "postinstall": "pnpm prisma:generate:safe",
    "prebuild": "pnpm prisma:generate:safe",
    "build": "next build",
    "prebuild:prod": "pnpm prisma:generate:safe",
    "build:prod": "dotenv -e .env.prod -- next build",
    "prestart": "pnpm prisma:generate:safe",
    "start": "next start --turbo",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "6.17.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "fastest-levenshtein": "1.0.16",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.562.0",
    "motion": "12.36.0",
    "next": "15",
    "openai": "6.32.0",
    "pusher": "5.3.2",
    "pusher-js": "8.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.7.0",
    "swr": "^2.3.8",
    "tailwind-merge": "3.3.1",
    "undici": "^7.22.0",
    "vitest": "4.0.18",
    "web-push": "3.6.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "tailwindcss": "3.4.18",
    "typescript": "5.6.3"
  }
}
