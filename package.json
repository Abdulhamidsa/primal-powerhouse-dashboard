{
  "name": "primal-powerhouse-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev --turbo",
    "dev:prod": "dotenv -e .env.prod -- next dev --turbo",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "db:studio:prod": "dotenv -e .env.prod -- prisma studio",
    "build": "next build",
    "start": "next start --turbo",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.17.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.562.0",
    "next": "15.2.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.3.8",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15.2.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "tailwindcss": "3.4.18",
    "typescript": "5.6.3"
  }
}
