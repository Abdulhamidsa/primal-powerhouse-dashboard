{
  "name": "primal-powerhouse-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/setup-prisma-provider.js && next dev --turbo",
    "build": "node scripts/setup-prisma-provider.js && prisma generate && next build",
    "deploy": "node scripts/setup-prisma-provider.js && prisma generate && prisma migrate deploy",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node scripts/setup-prisma-provider.js && prisma generate",
    "db:push": "node scripts/setup-prisma-provider.js && prisma db push",
    "db:migrate": "node scripts/setup-prisma-provider.js && prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "build:local": "next build",
    "build:production": "pnpm run prepare:prod && next build",
    "prepare:prod": "node scripts/prepare-production.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:vercel": "vercel --prod",
    "deploy:railway": "railway up",
    "deploy:docker": "docker build -t primal-powerhouse-dashboard . && docker run -d -p 3000:3000 primal-powerhouse-dashboard",
    "deploy:docker-compose": "docker-compose -f docker-compose.prod.yml up -d --build",
    "health-check": "curl http://localhost:3000/api/health",
    "production-setup": "pnpm run db:generate && pnpm run db:migrate && pnpm run build"
  },
  "dependencies": {
    "@prisma/client": "6.17.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.562.0",
    "next": "15.2.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.3.8",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "9.37.0",
    "eslint-config-next": "15.2.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "tailwindcss": "3.4.18",
    "typescript": "5.6.3"
  }
}
