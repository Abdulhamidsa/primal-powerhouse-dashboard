{
  "name": "primal-powerhouse-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "build:production": "npm run prepare:prod && next build",
    "build:vercel": "npm run prepare:prod && next build",
    "prepare:prod": "node scripts/prepare-production.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:vercel": "vercel --prod",
    "deploy:railway": "railway up",
    "deploy:docker": "docker build -t primal-powerhouse-dashboard . && docker run -d -p 3000:3000 primal-powerhouse-dashboard",
    "deploy:docker-compose": "docker-compose -f docker-compose.prod.yml up -d --build",
    "health-check": "curl http://localhost:3000/api/health",
    "production-setup": "npm run db:generate && npm run db:migrate && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.17.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.229.0",
    "next": "15.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.15.0"
}
