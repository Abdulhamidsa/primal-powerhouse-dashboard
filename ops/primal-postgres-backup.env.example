# Host-only configuration. Keep the password in PRIMAL_PGPASSFILE, never here.
PRIMAL_BACKUP_DIR=/var/backups/primal-powerhouse/postgresql
PRIMAL_BACKUP_RETENTION_COUNT=14
PRIMAL_DB_HOST=127.0.0.1
PRIMAL_DB_PORT=5432
PRIMAL_DB_NAME=primal_prod
PRIMAL_DB_USER=primal_prod_user
PRIMAL_PGPASSFILE=/etc/primal/postgres-backup.pgpass
