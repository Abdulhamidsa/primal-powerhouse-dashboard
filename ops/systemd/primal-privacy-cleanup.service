[Unit]
Description=Primal Powerhouse privacy cleanup (direct Node.js runtime)
Wants=network-online.target
After=network-online.target
OnFailure=primal-privacy-cleanup-failure.service

[Service]
Type=oneshot
User=primal
EnvironmentFile=-/etc/primal/backend.env
EnvironmentFile=-/etc/primal/operations.env
ExecStart=/usr/local/libexec/primal-run-privacy-cleanup
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
