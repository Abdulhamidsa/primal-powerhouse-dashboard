[Unit]
Description=Primal Powerhouse PostgreSQL custom-format backup
Wants=network-online.target
After=network-online.target postgresql.service
OnFailure=primal-postgres-backup-failure.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/primal/postgres-backup.env
ExecStart=/usr/bin/flock --nonblock /run/primal-postgres-backup.lock /usr/local/libexec/primal-backup-postgres
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/primal-powerhouse/postgresql
UMask=0077
